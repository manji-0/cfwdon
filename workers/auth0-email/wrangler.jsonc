{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfwdon-auth0-email",
  "main": "src/index.js",
  "compatibility_date": "2026-06-09",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sendmail.manji.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "DEFAULT_FROM": "cfwdon <noreply@manji.app>"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
