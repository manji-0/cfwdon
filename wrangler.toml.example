name = "cfwdon"
main = "crates/cfwdon-worker/build/index.js"
# Workers Cache requires a recent compatibility date.
compatibility_date = "2026-07-07"

[cache]
enabled = true

[observability]
enabled = true

[observability.logs]
enabled = true
head_sampling_rate = 1

[observability.traces]
enabled = true
head_sampling_rate = 1

[build]
command = "WASM_BINDGEN_BIN=\"$HOME/.cargo/bin/wasm-bindgen\" worker-build --release crates/cfwdon-worker"

[triggers]
crons = ["17 * * * *"]

[vars]
# Replace these before deploying a real instance.
INSTANCE_DOMAIN = "example.com"
INSTANCE_NAME = "cfwdon"
INSTANCE_DESCRIPTION = "Cloudflare Workers + D1 + R2 based Mastodon-compatible server"
SOURCE_URL = "https://github.com/YOUR_ORG/cfwdon"
INSTANCE_LANGUAGES = "en"
CONTACT_EMAIL = "admin@example.com"
INSTANCE_THUMBNAIL_URL = "https://media.example.com/site/thumbnail.png"
MEDIA_PUBLIC_BASE_URL = "https://media.example.com"

# Optional e-mail confirmation dispatch via Resend.
# RESEND_API_KEY should normally be configured as a secret, not here.
EMAIL_FROM = "cfwdon <noreply@example.com>"

# Protected routes validate Auth0-issued RS256 JWTs.
AUTH0_JWT_HEADER = "Authorization"
AUTH0_DOMAIN = "example.us.auth0.com"
AUTH0_CLIENT_ID = "replace-with-auth0-application-client-id"
AUTH0_AUDIENCE = "https://example.com/api"
AUTH0_EMAIL_CLAIM = "email"

# Configure these before the first real deploy. The binding names must stay
# in sync with crates/cfwdon-core/src/config.rs and the worker runtime code.
[[d1_databases]]
binding = "DB"
database_name = "cfwdon"
database_id = "replace-with-d1-database-id"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "cfwdon-media"

# Configure the bucket behind a public custom domain and keep that domain
# outside protected API authentication. Entity payloads will use MEDIA_PUBLIC_BASE_URL
# directly; /media/:id remains as a fallback/redirect route.

[[queues.producers]]
binding = "OUTBOX_PROCESS_QUEUE"
queue = "cfwdon-outbox-process"

[[queues.consumers]]
queue = "cfwdon-outbox-process"
max_batch_size = 10
max_batch_timeout = 0
max_retries = 3
max_concurrency = 1
