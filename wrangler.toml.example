name = "cfwdon"
main = "crates/cfwdon-worker/build/index.js"
# Workers Cache requires a recent compatibility date.
compatibility_date = "2026-07-07"

[cache]
enabled = true

[observability]
enabled = true

[observability.logs]
enabled = true
head_sampling_rate = 1

[observability.traces]
enabled = true
head_sampling_rate = 1

[build]
command = "worker-build --release crates/cfwdon-worker"

[triggers]
crons = ["17 * * * *"]

[vars]
# Replace these before deploying a real instance.
INSTANCE_DOMAIN = "example.com"
INSTANCE_NAME = "cfwdon"
INSTANCE_DESCRIPTION = "Cloudflare Workers + D1 + R2 based Mastodon-compatible server"
SOURCE_URL = "https://github.com/YOUR_ORG/cfwdon"
INSTANCE_LANGUAGES = "en"
CONTACT_EMAIL = "admin@example.com"
INSTANCE_THUMBNAIL_URL = "https://media.example.com/site/thumbnail.png"
MEDIA_PUBLIC_BASE_URL = "https://media.example.com"

# Optional longer about / privacy / terms bodies (plain text or HTML).
# HTML vars win when both plain and HTML are set.
# INSTANCE_EXTENDED_DESCRIPTION = "About this instance."
# INSTANCE_EXTENDED_DESCRIPTION_HTML = "<p>About this instance.</p>"
# INSTANCE_EXTENDED_DESCRIPTION_UPDATED_AT = "2026-07-23T00:00:00Z"
# PRIVACY_POLICY = "Privacy policy for this instance."
# PRIVACY_POLICY_HTML = "<p>Privacy policy for this instance.</p>"
# PRIVACY_POLICY_UPDATED_AT = "2026-07-23T00:00:00Z"
# TERMS_OF_SERVICE = "Terms of service for this instance."
# TERMS_OF_SERVICE_HTML = "<p>Terms of service for this instance.</p>"
# TERMS_OF_SERVICE_EFFECTIVE_DATE = "2026-07-23"

# Optional custom emoji registry (Mastodon CustomEmoji JSON array).
# CUSTOM_EMOJIS_JSON = '[{"shortcode":"blobaww","url":"https://media.example.com/custom_emojis/blobaww.png"}]'

# Optional e-mail confirmation dispatch via Resend.
# RESEND_API_KEY should normally be configured as a secret, not here.
EMAIL_FROM = "cfwdon <noreply@example.com>"

# Protected routes validate Auth0-issued RS256 JWTs.
AUTH0_JWT_HEADER = "Authorization"
AUTH0_DOMAIN = "example.us.auth0.com"
AUTH0_CLIENT_ID = "replace-with-auth0-application-client-id"
AUTH0_AUDIENCE = "https://example.com/api"
AUTH0_EMAIL_CLAIM = "email"

# Configure these before the first real deploy. The binding names must stay
# in sync with crates/cfwdon-core/src/config.rs and the worker runtime code.
[[d1_databases]]
binding = "DB"
database_name = "cfwdon"
database_id = "replace-with-d1-database-id"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "cfwdon-media"

# Host-level DoH SSRF validation cache for remote ActivityPub fetches.
[[kv_namespaces]]
binding = "REMOTE_DNS_CACHE"
id = "replace-with-remote-dns-cache-kv-namespace-id"
preview_id = "replace-with-remote-dns-cache-kv-preview-id"

# Account capability bits and other short-lived app cache entries.
[[kv_namespaces]]
binding = "APP_CACHE"
id = "replace-with-app-cache-kv-namespace-id"
preview_id = "replace-with-app-cache-kv-preview-id"

# Configure the bucket behind a public custom domain and keep that domain
# outside protected API authentication. Entity payloads will use MEDIA_PUBLIC_BASE_URL
# directly; /media/:id remains as a fallback/redirect route.

[[queues.producers]]
binding = "OUTBOX_PROCESS_QUEUE"
queue = "cfwdon-outbox-process"

[[queues.consumers]]
queue = "cfwdon-outbox-process"
max_batch_size = 10
max_batch_timeout = 0
max_retries = 3
max_concurrency = 1

[[durable_objects.bindings]]
name = "STREAM_HUB"
class_name = "StreamHub"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["StreamHub"]
